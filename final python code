import cv2
import os
import time
import shutil
import threading
import queue
import numpy as np
import serial


# ============================================================
#  SHARED CONFIG
# ============================================================

base_dir     = os.path.dirname(os.path.abspath(__file__))
dataset_path = os.path.join(base_dir, "dataset")
trainer_path = os.path.join(base_dir, "trainer.yml")
pin_file     = os.path.join(base_dir, "pin.txt")

os.makedirs(dataset_path, exist_ok=True)

# --- SERIAL ---
arduino      = serial.Serial('COM3', 9600, timeout=1)
serial_lock  = threading.Lock()
serial_queue = queue.Queue()
time.sleep(2)
print("Connected to Arduino.")

while arduino.in_waiting:
    arduino.readline()


def arduino_write(msg):
    """Thread-safe serial write."""
    with serial_lock:
        arduino.write(msg)
    print(f"[SENT] {msg}")


# ============================================================
#  SERIAL READER THREAD
#  Only thread that ever calls arduino.readline()
# ============================================================

def serial_reader_thread(stop_event):
    while not stop_event.is_set():
        try:
            if arduino.in_waiting:
                raw = arduino.readline()
                try:
                    msg = raw.decode().strip()
                except Exception:
                    msg = ""
                if msg:
                    serial_queue.put(msg)
                    print(f"[Arduino] {msg}")
            else:
                time.sleep(0.01)
        except Exception:
            time.sleep(0.05)


# ============================================================
#  DISPLAY THREAD
#  Runs imshow/waitKey — separate from main so input() works freely
# ============================================================

def display_thread(frame_queue, stop_event):
    while not stop_event.is_set():
        try:
            frame = frame_queue.get(timeout=0.05)
            if frame is None:
                cv2.destroyAllWindows()
            else:
                cv2.imshow("Security Camera", frame)
                if cv2.waitKey(1) == 27:
                    cv2.destroyAllWindows()
        except queue.Empty:
            pass
    cv2.destroyAllWindows()


# ============================================================
#  PIN MANAGEMENT
# ============================================================

def load_pin():
    if os.path.exists(pin_file):
        with open(pin_file, "r") as f:
            return f.read().strip()
    return "1234"

def save_pin(new_pin):
    with open(pin_file, "w") as f:
        f.write(new_pin)

def login():
    pin = load_pin()
    print("\n--- Security System ---")
    while True:
        entered = input("Enter PIN to access system: ").strip()
        if entered == pin:
            print("Access granted.")
            return
        else:
            print("Incorrect PIN. Try again.")

def change_pin():
    pin = load_pin()
    current = input("Enter current PIN: ").strip()
    if current != pin:
        print("Incorrect PIN.")
        return
    new1 = input("Enter new PIN: ").strip()
    new2 = input("Confirm new PIN: ").strip()
    if new1 != new2:
        print("PINs do not match.")
        return
    if not new1:
        print("PIN cannot be empty.")
        return
    save_pin(new1)
    print("PIN changed successfully.")


# ============================================================
#  TRAIN
# ============================================================

def run_train():
    people = [p for p in sorted(os.listdir(dataset_path))
              if os.path.isdir(os.path.join(dataset_path, p))]

    if not people:
        print("No dataset found. Capture images first.")
        arduino_write(b"TRAIN_FAILED\n")
        return

    print("Training started...")
    arduino_write(b"TRAINING\n")

    faces     = []
    labels    = []
    label_map = {}
    label_id  = 0

    face_cascade = cv2.CascadeClassifier(
        cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
    )

    for person_name in people:
        person_path = os.path.join(dataset_path, person_name)
        label_map[label_id] = person_name
        print(f"  Loading images for: {person_name}")

        for img_name in os.listdir(person_path):
            img_path = os.path.join(person_path, img_name)
            img = cv2.imread(img_path)
            if img is None:
                continue
            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
            faces_detected = face_cascade.detectMultiScale(gray, 1.05, 10, minSize=(100, 100))
            for (x, y, w, h) in faces_detected:
                faces.append(gray[y:y+h, x:x+w])
                labels.append(label_id)

        label_id += 1

    if not faces:
        print("No faces found in dataset images.")
        arduino_write(b"TRAIN_FAILED\n")
        return

    print(f"Training on {len(faces)} face samples...")
    recogniser = cv2.face.LBPHFaceRecognizer_create()
    recogniser.train(faces, np.array(labels))
    recogniser.save(trainer_path)

    print("Training complete. Label map:", label_map)
    arduino_write(b"TRAINING_DONE\n")


# ============================================================
#  CAPTURE + RETRAIN
# ============================================================

def run_update_database():
    name = input("Enter name for new person: ").strip()
    if not name:
        print("No name entered. Returning to menu.")
        return

    path = os.path.join(dataset_path, name)
    os.makedirs(path, exist_ok=True)
    print(f"Saving images to: {path}")
    print("Press SPACE to capture, ESC when done.")

    arduino_write(b"CAPTURE_READY\n")

    cap   = cv2.VideoCapture(0)
    count = 0

    while True:
        ret, frame = cap.read()
        if not ret:
            break

        display = frame.copy()
        cv2.putText(display, f"Name: {name} | Captured: {count}", (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)
        cv2.putText(display, "SPACE = capture | ESC = done", (10, 60),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
        cv2.imshow("Capture Mode", display)

        key = cv2.waitKey(1)
        if key == 32:
            filename = os.path.join(path, f"{count}.jpg")
            cv2.imwrite(filename, frame)
            print(f"Saved: {filename}")
            count += 1
        elif key == 27:
            break

    cap.release()
    cv2.destroyAllWindows()
    print(f"Capture done. {count} images saved for '{name}'.")
    arduino_write(b"CAPTURE_DONE\n")

    print("Retraining algorithm...")
    run_train()


# ============================================================
#  DELETE
# ============================================================

def run_delete():
    people = [p for p in sorted(os.listdir(dataset_path))
              if os.path.isdir(os.path.join(dataset_path, p))]

    if not people:
        print("No people in dataset.")
        return

    print("\nPeople in dataset:")
    for i, name in enumerate(people, 1):
        print(f"  {i}. {name}")

    choice = input("Enter number to delete (or anything else to cancel): ").strip()

    if not choice.isdigit() or not (1 <= int(choice) <= len(people)):
        print("Cancelled.")
        return

    name    = people[int(choice) - 1]
    confirm = input(f"Are you sure you want to delete '{name}'? (y/n): ").strip().lower()

    if confirm == "y":
        shutil.rmtree(os.path.join(dataset_path, name))
        print(f"Deleted '{name}' from dataset.")
        retrain = input("Retrain the algorithm now? (y/n): ").strip().lower()
        if retrain == "y":
            run_train()
    else:
        print("Cancelled.")


# ============================================================
#  CONTACT SECURITY
# ============================================================

def contact_security():
    arduino_write(b"CONTACT_SECURITY\n")
    print("Security company contacted.")


# ============================================================
#  RECOGNITION THREAD
#  Camera, detection, serial commands only — no imshow/waitKey
# ============================================================

def recognition_thread(system_armed, disarm_event, frame_queue, pin_requested):

    if not os.path.exists(trainer_path):
        print("No trained model found. Please train first.")
        arduino_write(b"ERROR_NO_MODEL\n")
        frame_queue.put(None)
        return

    people = [p for p in sorted(os.listdir(dataset_path))
              if os.path.isdir(os.path.join(dataset_path, p))]
    if not people:
        print("No dataset found.")
        arduino_write(b"ERROR_NO_DATASET\n")
        frame_queue.put(None)
        return

    face_cascade = cv2.CascadeClassifier(
        cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
    )
    recogniser = cv2.face.LBPHFaceRecognizer_create()
    recogniser.read(trainer_path)
    label_map = {i: name for i, name in enumerate(people)}

    print("Recognition running in background.")

    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(10, 10))
    cap   = cv2.VideoCapture(0)

    checkFaceRequested = False
    pin_entry_active   = False
    pin_deadline       = 0
    PIN_TIMEOUT        = 30
    last_check_time    = 0
    SENSOR_COOLDOWN    = 8

    # Block CHECK_FACE responses during exit delay (60s after arming)
    EXIT_DELAY         = 60
    arm_time           = time.time()
    exit_delay_active  = True

    while not disarm_event.is_set():

        # --- READ FROM SERIAL QUEUE ---
        try:
            msg = serial_queue.get_nowait()
            if msg == "CHECK_FACE":
                now = time.time()
                if (not pin_entry_active
                        and not exit_delay_active
                        and now - last_check_time >= SENSOR_COOLDOWN):
                    checkFaceRequested = True
                    last_check_time    = now
        except queue.Empty:
            pass

        # --- UPDATE EXIT DELAY ---
        if exit_delay_active:
            elapsed   = time.time() - arm_time
            remaining_exit = int(EXIT_DELAY - elapsed)
            if elapsed >= EXIT_DELAY:
                exit_delay_active = False
                print("System fully armed.")

        # --- CAMERA FRAME ---
        ret, frame = cap.read()
        if not ret:
            break

        gray  = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        gray  = clahe.apply(gray)
        faces = face_cascade.detectMultiScale(gray, 1.05, 10, minSize=(100, 100))

        numFaces     = len(faces)
        system_state = "NO_FACE"

        if numFaces > 0:
            for (x, y, w, h) in faces:
                centreX = x + (w // 2)
                centreY = y + (h // 2)

                face        = gray[y:y+h, x:x+w]
                label, conf = recogniser.predict(face)
                name        = label_map.get(label, "Unknown")

                if conf < 65:
                    system_state = "KNOWN"
                    colour       = (0, 255, 0)
                    text         = f"{name} ({int(100 - conf)}%)"
                else:
                    system_state = "UNKNOWN"
                    colour       = (0, 0, 255)
                    text         = "Unknown"

                cv2.rectangle(frame, (x, y), (x+w, y+h), colour, 2)
                cv2.putText(frame, text, (x, y - 10),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.8, colour, 2)
                cv2.circle(frame, (centreX, centreY), 5, (255, 255, 0), -1)

            if numFaces > 1:
                system_state = "MULTI_FACE"

        # --- RESPOND TO CHECK_FACE ---
        if checkFaceRequested:
            if system_state == "KNOWN":
                arduino_write(b"FACE_OK\n")
                pin_entry_active = True
                pin_deadline     = time.time() + PIN_TIMEOUT
                pin_requested.set()
                print(f"Known face detected. Enter PIN within {PIN_TIMEOUT}s to disarm.")
            elif system_state in ("UNKNOWN", "MULTI_FACE"):
                arduino_write(b"FACE_UNKNOWN\n")
                # Log timestamp to file and send to Arduino
                ts       = time.strftime("%Y-%m-%d %H:%M:%S")
                log_path = os.path.join(base_dir, "intruder_log.txt")
                with open(log_path, "a") as f:
                    f.write(f"{ts} - Unknown face detected\n")
                print(f"Intruder logged: {ts}")
                arduino_write(f"LOG:{ts}\n".encode())
            else:
                arduino_write(b"FACE_NONE\n")
            checkFaceRequested = False

        # --- PIN COUNTDOWN ---
        if pin_entry_active:
            remaining = int(pin_deadline - time.time())
            cv2.putText(frame, f"Enter PIN to disarm: {remaining}s", (10, 30),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 165, 255), 2)

            if disarm_event.is_set():
                pin_entry_active = False
                break

            if remaining <= 0:
                print("PIN timeout. Triggering alarm.")
                arduino_write(b"PIN_TIMEOUT\n")
                pin_entry_active = False
                pin_requested.clear()

        # --- STATUS OVERLAY ---
        if exit_delay_active:
            cv2.putText(frame, f"Leaving: {remaining_exit}s", (10, frame.shape[0] - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 165, 255), 2)
        else:
            cv2.putText(frame, "ARMED", (10, frame.shape[0] - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 255), 2)

        # --- SEND FRAME TO DISPLAY THREAD ---
        if frame_queue.full():
            try:
                frame_queue.get_nowait()
            except queue.Empty:
                pass
        frame_queue.put(frame)

    cap.release()
    frame_queue.put(None)
    print("Recognition stopped.")


# ============================================================
#  MAIN — all input() calls live here (Windows requirement)
# ============================================================

def print_menu(system_armed):
    status = "ARMED" if system_armed[0] else "DISARMED"
    print(f"\n--- Security System Menu [{status}] ---")
    print("1. Arm / Disarm system")
    print("2. Update database (add person + retrain)")
    print("3. Delete person from database")
    print("4. Change PIN")
    print("5. Contact security company")
    print("6. View intruder log")
    print("7. Exit")
    print("Select option: ", end="", flush=True)


def main():
    # Step 1 — login on main thread
    login()

    # Step 2 — signal Arduino
    arduino_write(b"READY\n")

    system_armed  = [False]
    disarm_event  = threading.Event()
    pin_requested = threading.Event()  # set by recognition thread when known face detected
    recog_thread  = [None]
    frame_queue   = queue.Queue(maxsize=2)

    # Start serial reader thread
    serial_stop = threading.Event()
    s_thread = threading.Thread(
        target=serial_reader_thread,
        args=(serial_stop,),
        daemon=True
    )
    s_thread.start()

    # Start display thread
    display_stop = threading.Event()
    d_thread = threading.Thread(
        target=display_thread,
        args=(frame_queue, display_stop),
        daemon=True
    )
    d_thread.start()

    # --- MAIN MENU LOOP (main thread — input() safe here) ---
    while True:

        # If recognition thread flagged a known face, ask for PIN immediately
        if pin_requested.is_set():
            print("\n--- KNOWN FACE DETECTED ---")
            print(f"Enter PIN to disarm (or wait for timeout): ", end="", flush=True)
            entered = input().strip()
            pin = load_pin()
            if entered == pin:
                system_armed[0] = False
                pin_requested.clear()
                disarm_event.set()
                if recog_thread[0]:
                    recog_thread[0].join(timeout=3)
                disarm_event.clear()
                recog_thread[0] = None
                arduino_write(b"DISARMED\n")
                print("Correct PIN. System disarmed.")
            else:
                print("Incorrect PIN.")
                # Don't clear pin_requested — let it keep asking until timeout
            continue

        print_menu(system_armed)
        choice = input().strip()

        if choice == "1":
            if system_armed[0]:
                # Disarm
                pin     = load_pin()
                entered = input("Enter PIN to disarm: ").strip()
                if entered == pin:
                    system_armed[0] = False
                    disarm_event.set()
                    if recog_thread[0]:
                        recog_thread[0].join(timeout=3)
                    disarm_event.clear()
                    recog_thread[0] = None
                    arduino_write(b"DISARMED\n")
                    print("System disarmed.")
                else:
                    print("Incorrect PIN.")
            else:
                # Arm
                print("Arming system. You have 60 seconds to leave.")
                arduino_write(b"ARM\n")
                system_armed[0] = True
                disarm_event.clear()
                t = threading.Thread(
                    target=recognition_thread,
                    args=(system_armed, disarm_event, frame_queue, pin_requested),
                    daemon=True
                )
                recog_thread[0] = t
                t.start()

        elif choice == "2":
            if system_armed[0]:
                print("Disarm the system before updating the database.")
            else:
                run_update_database()

        elif choice == "3":
            if system_armed[0]:
                print("Disarm the system before deleting from the database.")
            else:
                run_delete()

        elif choice == "4":
            change_pin()

        elif choice == "5":
            contact_security()

        elif choice == "6":
            log_path = os.path.join(base_dir, "intruder_log.txt")
            if os.path.exists(log_path):
                print("\n--- Intruder Log ---")
                with open(log_path, "r") as f:
                    entries = f.readlines()
                if entries:
                    for entry in entries:
                        print(entry.strip())
                else:
                    print("No entries yet.")
            else:
                print("No intruder log found.")

        elif choice == "7":
            print("Exiting.")
            if system_armed[0]:
                disarm_event.set()
                if recog_thread[0]:
                    recog_thread[0].join(timeout=3)
            arduino_write(b"SHUTDOWN\n")
            serial_stop.set()
            display_stop.set()
            break

        else:
            print("Invalid option, please enter 1-7.")

    print("System shut down.")


if __name__ == "__main__":
    main()
