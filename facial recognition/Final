import cv2
import os
import time
import numpy as np
#import serial


# ============================================================
#  SHARED CONFIG
# ============================================================

base_dir = os.path.dirname(os.path.abspath(__file__))
dataset_path = os.path.join(base_dir, "dataset")
trainer_path = os.path.join(base_dir, "trainer.yml")


# ============================================================
#  CAPTURE
# ============================================================

def run_capture():
    name = input("Enter your name: ").strip()

    if not name:
        print("No name entered. Returning to menu.")
        return

    path = os.path.join(dataset_path, name)
    os.makedirs(path, exist_ok=True)
    print(f"Saving images to: {path}")

    cap = cv2.VideoCapture(0)
    count = 0

    while True:
        ret, frame = cap.read()
        if not ret:
            break

        display = frame.copy()
        cv2.putText(display, f"Name: {name} | Captured: {count}", (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)
        cv2.imshow("Press SPACE to capture | ESC to quit", display)

        key = cv2.waitKey(1)

        if key == 32:  # Space - capture
            filename = os.path.join(path, f"{count}.jpg")
            cv2.imwrite(filename, frame)
            print(f"Saved: {filename}")
            count += 1

        elif key == 27:  # ESC - quit
            break

    cap.release()
    cv2.destroyAllWindows()
    print(f"Done. {count} images saved for '{name}'.")

    # Offer to retrain immediately after capture
    retrain = input("Retrain the algorithm now? (y/n): ").strip().lower()
    if retrain == "y":
        run_train()


# ============================================================
#  TRAIN
# ============================================================

def run_train():
    if not os.path.exists(dataset_path) or not os.listdir(dataset_path):
        print("No dataset found. Please capture images first.")
        return

    print("Reading dataset from:", dataset_path)

    faces = []
    labels = []
    label_map = {}
    label_id = 0

    face_cascade = cv2.CascadeClassifier(
        cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
    )

    for person_name in sorted(os.listdir(dataset_path)):
        person_path = os.path.join(dataset_path, person_name)

        if not os.path.isdir(person_path):
            continue

        label_map[label_id] = person_name
        print(f"  Loading images for: {person_name}")

        for img_name in os.listdir(person_path):
            img_path = os.path.join(person_path, img_name)

            img = cv2.imread(img_path)
            if img is None:
                continue

            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
            faces_detected = face_cascade.detectMultiScale(gray, 1.1, 5)

            for (x, y, w, h) in faces_detected:
                face = gray[y:y+h, x:x+w]
                faces.append(face)
                labels.append(label_id)

        label_id += 1

    if not faces:
        print("No faces found in dataset. Make sure your images contain detectable faces.")
        return

    print(f"Training on {len(faces)} face samples...")
    recogniser = cv2.face.LBPHFaceRecognizer_create()
    recogniser.train(faces, np.array(labels))
    recogniser.save(trainer_path)

    print("Training complete.")
    print("Label map:", label_map)


# ============================================================
#  RECOGNISE (MAIN)
# ============================================================

def run_recognise():
    if not os.path.exists(trainer_path):
        print("No trained model found. Please train the algorithm first.")
        return

    if not os.path.exists(dataset_path) or not os.listdir(dataset_path):
        print("No dataset found. Please capture images first.")
        return

    # --- LOAD MODEL ---
    face_cascade = cv2.CascadeClassifier(
        cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
    )

    recogniser = cv2.face.LBPHFaceRecognizer_create()
    recogniser.read(trainer_path)
    print("Loading model from:", trainer_path)

    # --- BUILD LABEL MAP FROM DATASET FOLDERS ---
    # Must use sorted() to match the order used during training
    label_map = {}
    label_id = 0
    for person_name in sorted(os.listdir(dataset_path)):
        person_path = os.path.join(dataset_path, person_name)
        if os.path.isdir(person_path):
            label_map[label_id] = person_name
            label_id += 1

    print("Label map:", label_map)

    # --- LOW LIGHT ---
    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8, 8))  # clipLimit = contrast boost

    # --- PRINT THROTTLE ---
    last_print_time = 0
    print_delay = 2  # seconds between prints

    # --- SERIAL ---
    #arduino = serial.Serial('COM3', 9600, timeout=1)
    #time.sleep(2)

    # --- CAMERA ---
    cap = cv2.VideoCapture(0)

    checkFaceRequested = False
    saveFaceRequested = False

    while True:

        # --- READ FROM ARDUINO ---
        #if arduino.in_waiting:
        #    msg = arduino.readline().decode().strip()
        #    if msg == "CHECK_FACE":
        #        print("Checking face...")
        #        checkFaceRequested = True
        #    elif msg == "SAVE_FACE":
        #        print("Saving unknown face...")
        #        saveFaceRequested = True

        ret, frame = cap.read()
        if not ret:
            break

        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        gray = clahe.apply(gray)

        # scaleFactor=1.05, minNeighbours=5, minSize filters out tiny false positives
        faces = face_cascade.detectMultiScale(gray, 1.05, 5, minSize=(60, 60))

        numFaces = len(faces)
        recognised = False
        system_state = "IDLE"

        # ---------------- FACE ANALYSIS ----------------

        if numFaces == 0:
            system_state = "NO_FACE"

        else:
            for (x, y, w, h) in faces:

                centreX = x + (w // 2)
                centreY = y + (h // 2)

                face = gray[y:y+h, x:x+w]
                label, confidence = recogniser.predict(face)
                name = label_map.get(label, "Unknown")

                if confidence < 80:
                    recognised = True
                    system_state = "KNOWN"
                    colour = (0, 255, 0)
                    text = f"{name} ({int(confidence)})"
                else:
                    system_state = "UNKNOWN"
                    colour = (0, 0, 255)
                    text = "Unknown"

                cv2.rectangle(frame, (x, y), (x+w, y+h), colour, 2)
                cv2.putText(frame, text, (x, y-10),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.8, colour, 2)

                cv2.circle(frame, (centreX, centreY), 5, (255, 255, 0), -1)

            if numFaces > 1:
                system_state = "MULTI_FACE"

        # --- FACE CHECK RESPONSE ---
        if checkFaceRequested:
            current_time = time.time()
            if current_time - last_print_time >= print_delay:
                if system_state == "NO_FACE":
                    print("No face detected")
                elif system_state == "KNOWN":
                    print("Recognised user")
                elif system_state == "UNKNOWN":
                    print("Unknown person detected")
                elif system_state == "MULTI_FACE":
                    print("Multiple faces")
                last_print_time = current_time
            checkFaceRequested = False

        # --- SAVE UNKNOWN FACE ---
        if saveFaceRequested:
            intruder_folder = os.path.join(base_dir, "intruders")
            os.makedirs(intruder_folder, exist_ok=True)
            timestamp = int(time.time())
            filename = os.path.join(intruder_folder, f"intruder_{timestamp}.jpg")
            cv2.imwrite(filename, frame)
            print(f"Saved: {filename}")
            saveFaceRequested = False

        # ---------------- DISPLAY ----------------
        cv2.imshow("Camera", frame)

        key = cv2.waitKey(1)
        if key == 27:  # ESC
            break

    cap.release()
    cv2.destroyAllWindows()


# ============================================================
#  DELETE PERSON FROM DATASET
# ============================================================

def run_delete():
    import shutil

    if not os.path.exists(dataset_path) or not os.listdir(dataset_path):
        print("No dataset found. Nothing to delete.")
        return

    people = [p for p in sorted(os.listdir(dataset_path))
              if os.path.isdir(os.path.join(dataset_path, p))]

    if not people:
        print("No people found in dataset.")
        return

    print("\nPeople in dataset:")
    for i, name in enumerate(people, 1):
        print(f"  {i}. {name}")

    choice = input("Enter the number to delete (or anything else to cancel): ").strip()

    if not choice.isdigit() or not (1 <= int(choice) <= len(people)):
        print("Invalid choice. Returning to menu.")
        return

    name = people[int(choice) - 1]
    confirm = input(f"Are you sure you want to delete '{name}'? (y/n): ").strip().lower()

    if confirm == "y":
        shutil.rmtree(os.path.join(dataset_path, name))
        print(f"Deleted '{name}' from dataset.")

        retrain = input("Retrain the algorithm now? (y/n): ").strip().lower()
        if retrain == "y":
            run_train()
    else:
        print("Cancelled.")


# ============================================================
#  MENU
# ============================================================

def main():
    while True:
        print("\n--- Facial Recognition System ---")
        print("1. Capture images")
        print("2. Train algorithm")
        print("3. Run recognition")
        print("4. Delete person from dataset")
        print("5. Exit")

        choice = input("Select an option: ").strip()

        if choice == "1":
            run_capture()
        elif choice == "2":
            run_train()
        elif choice == "3":
            run_recognise()
        elif choice == "4":
            run_delete()
        elif choice == "5":
            print("Exiting.")
            break
        else:
            print("Invalid option, please enter 1-5.")


if __name__ == "__main__":
    main()